-- The ipv6-ra-filter script adds the MAC addresses of the selected router to this chain.
-- The number is above 399-parker-radv-filterd and 401-parker-radv-input, so that
-- PARKER_RADV drops the router advertisements first on an active Parker node.
-- Until the script knows the selected router, the chain accepts all router
-- advertisements. Thus a node never loses IPv6 because the filter state is unknown.
chain('IPV6_RA_FILTER', 'DROP')
rule('IPV6_RA_FILTER -j ACCEPT')
rule('FORWARD -p IPv6 -i bat0 --ip6-protocol ipv6-icmp --ip6-icmp-type router-advertisement -j IPV6_RA_FILTER')
rule('INPUT -p IPv6 -i bat0 --ip6-protocol ipv6-icmp --ip6-icmp-type router-advertisement -j IPV6_RA_FILTER')
