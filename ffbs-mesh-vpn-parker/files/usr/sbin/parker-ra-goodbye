#!/bin/sh
# Tell the local clients that this node is no longer their router, but only
# when a new router is there (make before break). See parker/ragoodbye.lua.
#
# Usage: parker-ra-goodbye WAIT DURATION VALID PREFIX...
#
# The script waits at most WAIT seconds for an IPv6 default route of the
# node through another router on br-client. Then it sends router
# advertisements with router lifetime 0, preferred lifetime 0 and valid
# lifetime VALID for each PREFIX, for DURATION seconds. If no other router
# comes, it sends nothing: the router lifetime on the clients ends by itself.
# A router lifetime 0 without a new router makes some clients (Android 15
# with CLAT) disconnect from the Wi-Fi.

IFACE=br-client
PID_FILE=${PID_FILE:-/tmp/parker-ra-goodbye.pid}
URADVD=${URADVD:-/usr/sbin/uradvd}
# Time from the first router advertisement of the new router to the default
# route on the clients
GRACE=2

[ $# -ge 4 ] || exit 1
wait_max=$1 duration=$2 valid=$3
shift 3

own_lladdr() {
	ip -6 addr show dev "$IFACE" scope link 2>/dev/null |
		awk '$1 == "inet6" { sub(/\/.*/, "", $2); print $2; exit }'
}

# A default route through a router that is not this node
new_router() {
	ip -6 route show default dev "$IFACE" 2>/dev/null | awk -v own="$1" '{
		for (i = 1; i < NF; i++)
			if ($i == "via" && $(i + 1) != own) { print $(i + 1); exit }
	}'
}

ipt() {
	ip6tables -w -t mangle "$@"
}

# A TERM signal (ragoodbye.cancel) must stop the script at once, also in a
# sleep: the node can start its own router advertisement daemon again.
nap() {
	sleep "$1" &
	nap_pid=$!
	wait "$nap_pid"
	nap_pid=""
}

rule=""
pid=""
nap_pid=""
cleanup() {
	[ -n "$nap_pid" ] && kill "$nap_pid" 2>/dev/null
	[ -n "$pid" ] && kill "$pid" 2>/dev/null
	# shellcheck disable=SC2086
	[ -n "$rule" ] && ipt -D $rule 2>/dev/null
	[ "$(cat "$PID_FILE" 2>/dev/null)" = "$$" ] && rm -f "$PID_FILE"
}
trap cleanup EXIT
trap 'exit 0' TERM INT

echo "$$" > "$PID_FILE"

own=$(own_lladdr)
waited=0
router=$(new_router "$own")
while [ -z "$router" ]; do
	if [ "$waited" -ge "$wait_max" ]; then
		logger -t parker-ra-goodbye "No new IPv6 router after ${wait_max}s. Sending no router lifetime 0."
		exit 0
	fi
	nap 1
	waited=$((waited + 1))
	router=$(new_router "$own")
done
nap "$GRACE"

args=""
for prefix in "$@"; do
	args="$args -a $prefix"
done
logger -t parker-ra-goodbye "New IPv6 router $router after ${waited}s. Router lifetime 0 for $* (${duration}s)."
# The node receives its own router advertisements (multicast loop). Do not
# let odhcp6c on the node add the old prefixes again.
if [ -n "$own" ]; then
	rule="INPUT -i $IFACE -s $own -p ipv6-icmp --icmpv6-type router-advertisement -j DROP"
	# shellcheck disable=SC2086
	ipt -I $rule 2>/dev/null || rule=""
fi
# shellcheck disable=SC2086
"$URADVD" -i "$IFACE" --default-lifetime 0 --preferred-lifetime 0 --valid-lifetime "$valid" \
	--min-router-adv-interval 3 --max-router-adv-interval 4 $args >/dev/null 2>&1 &
pid=$!
nap "$duration"
