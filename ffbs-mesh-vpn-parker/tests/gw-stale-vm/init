#!/bin/sh
# shellcheck disable=SC2015,SC2046,SC2086,SC2254
export PATH=/usr/sbin:/bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t tmpfs tmp /run; mount -t devtmpfs dev /dev 2>/dev/null
for m in crc16 crc32c_generic libcrc32c rfkill cfg80211 llc stp bridge veth; do insmod /lib/mods/$m.ko 2>/dev/null; done
insmod /lib/mods/batman-adv.ko && echo BATMAN_V > /sys/module/batman_adv/parameters/routing_algo || { echo INSMOD FAIL; dmesg | tail -15; }
uevent /bin/hotplug &
ip() { /usr/sbin/ip "$@"; }
up() { cut -d' ' -f1 /proc/uptime; }
ip link add name sw type bridge; ip link set dev sw up
for x in a b; do ip netns add $x; done
mk() { # name ns
  ip link add name e$1 type veth peer name s$1; ip link set dev s$1 master sw; ip link set dev s$1 up
  [ -n "$2" ] && ip link set dev e$1 netns $2
}
mk n ""; mk a a; mk b b
setup() { # ns-prefix iface
  $1 ip link add name bat0 type batadv; $1 ip link set dev e$2 master bat0; $1 ip link set dev e$2 up; $1 ip link set dev bat0 up
}
setup "" n; setup "ip netns exec a" a; setup "ip netns exec b" b
ip netns exec a batctl gw_mode server 100mbit/100mbit
ip netns exec b batctl gw_mode server 100mbit/100mbit
batctl gw_mode client
MA=$(ip netns exec a cat /sys/class/net/ea/address); MB=$(ip netns exec b cat /sys/class/net/eb/address)
# orig address = primary hardif MAC
sel() { batctl gwl -H 2>/dev/null | grep '^\*' | awk '{print $2}'; }
name() { case "$1" in $MA) echo a;; $MB) echo b;; "") echo none;; *) echo "$1";; esac; }
echo "=== MODULE $(cat /proc/cmdline | grep -o 'mod=[a-z]*')"
t=0; while [ -z "$(sel)" ] && [ $t -lt 120 ]; do sleep 1; t=$((t+1)); done
sleep 15
S=$(name $(sel)); echo "SELECTED $S at $(up)"; batctl gwl -H
cut_gw() { ip link set dev s$1 down; }
restore_gw() { ip link set dev s$1 up; }
measure() { # expect change away from $1, max $2 s
  t0=$(up); i=0
  while [ $i -lt $(($2*2)) ]; do
    c=$(name $(sel)); if [ "$c" != "$1" ]; then echo "SWITCH $1 -> $c after $(awk -v a=$t0 -v b=$(up) 'BEGIN{print b-a}') s"; return; fi
    sleep 0.5; i=$((i+1))
  done
  echo "NO SWITCH from $1 within $2 s (still $(name $(sel)))"
}
echo "--- T1: power loss of the selected gw $S"
cut_gw $S; measure $S 260
echo "--- T2: restore $S, watch 40 s for a switch back"
restore_gw $S; sleep 40; echo "SELECTED after restore: $(name $(sel))"
C=$(name $(sel)); echo "--- T3: cut both gws, current $C, watch 30 s (want: keep, no DEL)"
cut_gw a; cut_gw b; sleep 30; echo "SELECTED with no gw alive: $(name $(sel))"
echo "--- T4: restore $C only, after 10 s cut... restore both"
restore_gw a; restore_gw b; sleep 20; echo "SELECTED after both back: $(name $(sel))"
echo "=== DONE"
poweroff -f
